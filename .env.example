DATABASE_URL=postgresql://postgres.YOUR-PROJECT:YOUR-PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:6543/postgres
PAYLOAD_SECRET=YOUR_SECRET_HERE
SEED_TOKEN=your-seed-token-here
NEXT_PUBLIC_APP_URL=http://localhost:3000

# S3 Storage (Supabase Storage)
S3_BUCKET=files
S3_ACCESS_KEY_ID=your-s3-access-key
S3_SECRET_ACCESS_KEY=your-s3-secret-key
S3_REGION=us-east-1
S3_ENDPOINT=https://YOUR-PROJECT.storage.supabase.co/storage/v1/s3
